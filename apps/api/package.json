{
  "name": "@alitracker/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src scripts test drizzle.config.ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "r2:test": "tsx scripts/test-r2.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@alitracker/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.1131.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.40.1",
    "express": "^5.1.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.30.5",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "vitest": "^3.0.8"
  }
}
